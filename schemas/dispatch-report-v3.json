{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-dispatch-report-v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit_sha256", "subject", "capture_id", "release_id", "package_ref", "package_sha256", "analysis_package_binding", "analysis", "critical_review", "terra_initial", "terra_final", "stage_runtime", "formal_write_count"],
  "properties": {
    "schema_version": {"const": "study-intake-dispatch-report-v3"},
    "unit_sha256": {"$ref": "#/$defs/sha"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "capture_id": {"type": "string", "minLength": 1},
    "release_id": {"$ref": "#/$defs/sha"},
    "package_ref": {"type": "string", "pattern": "^study-intake-dispatch-package://sha256/[0-9a-f]{64}$"},
    "package_sha256": {"$ref": "#/$defs/sha"},
    "analysis_package_binding": {"$ref": "#/$defs/binding"},
    "analysis": {"type": "object", "minProperties": 1},
    "critical_review": {"type": "object", "minProperties": 1},
    "terra_initial": {"type": "object", "minProperties": 1},
    "terra_final": {"type": "object", "minProperties": 1},
    "stage_runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis", "critical_review"],
      "properties": {
        "analysis": {"type": "object", "required": ["analysis_package_stages"]},
        "critical_review": {"type": "object", "required": ["analysis_package_stages"]}
      }
    },
    "formal_write_count": {"const": 0}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "sha256", "ref"],
      "properties": {
        "schema_version": {"const": "study-intake-analysis-package-binding-v1"},
        "id": {"type": "string", "pattern": "^ANPKG2-[A-F0-9]{24}$"},
        "sha256": {"$ref": "#/$defs/sha"},
        "ref": {"type": "string", "pattern": "^study-intake-analysis-package://sha256/[0-9a-f]{64}$"}
      }
    }
  }
}
