{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/terra-final-report-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "subject", "capture_id", "plan_sha256", "read_bundle_sha256", "ordered_luna_reports", "luna_assessments", "summary", "subject_analysis", "proposals", "conflicts", "evidence_gaps", "sol_checklist", "warnings", "formal_write_count", "report_sha256"],
  "properties": {
    "schema_version": {"const": "terra_final_report_v1"}, "subject": {"enum": ["math", "cs408", "english"]},
    "capture_id": {"type": "string", "minLength": 1}, "plan_sha256": {"$ref": "#/$defs/sha"}, "read_bundle_sha256": {"$ref": "#/$defs/sha"},
    "ordered_luna_reports": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/luna_binding"}},
    "luna_assessments": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/luna_assessment"}},
    "summary": {"type": "string", "minLength": 1, "maxLength": 16000}, "subject_analysis": {"$ref": "#/$defs/subject_analysis"}, "proposals": {"type": "array"}, "conflicts": {"type": "array"},
    "evidence_gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "sol_checklist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "formal_write_count": {"const": 0}, "report_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "luna_binding": {"type": "object", "additionalProperties": false, "required": ["branch_id", "report_sha256", "report_ref"], "properties": {"branch_id": {"type": "string", "minLength": 1}, "report_sha256": {"$ref": "#/$defs/sha"}, "report_ref": {"type": "string", "pattern": "^study-intake-luna-investigation-report://sha256/[0-9a-f]{64}$"}}},
    "luna_assessment": {"type": "object", "additionalProperties": false, "required": ["branch_id", "disposition", "rationale"], "properties": {"branch_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["adopt", "modify", "reject", "uncertain"]}, "rationale": {"type": "string", "minLength": 1}}},
    "subject_analysis": {"type": "object", "additionalProperties": false, "required": ["subject", "sections", "formal_write_count"], "properties": {"subject": {"enum": ["math", "cs408", "english"]}, "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject_section"}}, "formal_write_count": {"const": 0}}},
    "subject_section": {"type": "object", "additionalProperties": false, "required": ["kind", "summary", "details", "evidence_refs", "confidence"], "properties": {"kind": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "details": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}}}
  }
}
