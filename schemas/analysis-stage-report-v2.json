{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-intake-analysis-stage-report-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stage", "subject", "capture_id", "summary",
    "proposals", "duplicate_candidates", "warnings", "evidence_refs",
    "normalization_status", "formal_write_count"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "study-intake-analysis-stage-report-v2"},
    "stage": {"type": "string", "enum": ["terra_analysis", "luna_analysis", "terra_final"]},
    "subject": {"type": "string", "enum": ["math", "cs408", "english"]},
    "capture_id": {"type": "string", "minLength": 1, "maxLength": 180},
    "summary": {"type": "string", "minLength": 1, "maxLength": 16000},
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "target_hint", "field_hints", "evidence_refs"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "target_hint": {"type": ["string", "null"]},
          "field_hints": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "duplicate_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "reason", "evidence_refs"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(mcp-item:(math|cs408|english):|study-intake-(durable-capture|analysis-stage-execution-receipt|model-stage-raw-output|direct-model-stage-raw)://sha256/[0-9a-f]{64}$)"
      }
    },
    "normalization_status": {
      "type": "string", "enum": ["complete", "incomplete"]
    },
    "formal_write_count": {"type": "integer", "const": 0}
  }
}
