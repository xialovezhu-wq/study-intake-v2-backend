{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-intake-nightly-sol-batch-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "subject", "capture_intake_date",
    "capture_ids", "capture_set_sha256", "analysis_packages", "skill",
    "status", "formal_write_count"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-nightly-sol-batch-v1"},
    "batch_id": {"type": "string", "pattern": "^NIGHTLY-[A-F0-9]{28}$"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "capture_intake_date": {"type": "string", "format": "date"},
    "capture_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "capture_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_packages": {"type": "array", "minItems": 1},
    "skill": {"type": "object"},
    "status": {"const": "frozen"},
    "formal_write_count": {"const": 0}
  }
}
