{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-intake-analysis-package-v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "package_id", "capture_id", "subject", "study_date", "captured_at", "capture_intake_date", "capture", "plan", "read_bundle", "terra_initial", "terra_initial_execution", "luna_outputs", "ordered_luna_reports", "ordered_luna_diagnostics", "terra_final", "terra_final_execution", "sol_handoff", "status", "formal_write_count"],
  "properties": {
    "schema_version": {"const": "study-intake-analysis-package-v2"},
    "package_id": {"type": "string", "pattern": "^ANPKG2-[A-F0-9]{24}$"},
    "capture_id": {"type": "string", "minLength": 1}, "subject": {"enum": ["math", "cs408", "english"]},
    "study_date": {"type": "string", "format": "date"}, "captured_at": {"type": "string", "format": "date-time"}, "capture_intake_date": {"type": "string", "format": "date"},
    "capture": {"$ref": "#/$defs/binding"}, "plan": {"$ref": "#/$defs/binding"}, "read_bundle": {"$ref": "#/$defs/binding"}, "terra_initial": {"$ref": "#/$defs/binding"}, "terra_initial_execution": {"$ref": "#/$defs/terra_execution"},
    "luna_outputs": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/luna_binding"}},
    "ordered_luna_reports": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/luna_binding"}},
    "ordered_luna_diagnostics": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/luna_binding"}},
    "terra_final": {"$ref": "#/$defs/binding"}, "terra_final_execution": {"$ref": "#/$defs/terra_execution"}, "sol_handoff": {"$ref": "#/$defs/binding"},
    "status": {"const": "ready_for_nightly"}, "formal_write_count": {"const": 0}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["kind", "schema_version", "sha256", "ref"], "properties": {"kind": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "ref": {"type": "string", "pattern": "^study-intake-[a-z-]+://sha256/[0-9a-f]{64}$"}}},
    "terra_execution": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_model", "requested_reasoning_effort", "provider_stage_name", "raw_output_sha256", "raw_output_ref", "stage_execution_receipt_sha256", "stage_execution_receipt_ref", "normalization_receipt_sha256", "normalization_receipt_ref", "formal_write_count"],
      "properties": {
        "requested_model": {"const": "gpt-5.6-terra"},
        "requested_reasoning_effort": {"const": "max"},
        "provider_stage_name": {"enum": ["math_analysis", "math_critical_review", "cs408_analysis", "cs408_critical_review", "english_analysis", "english_critical_review"]},
        "raw_output_sha256": {"$ref": "#/$defs/sha"},
        "raw_output_ref": {"type": "string", "pattern": "^study-intake-(model-stage-raw-output|direct-model-stage-raw)://sha256/[0-9a-f]{64}$"},
        "stage_execution_receipt_sha256": {"$ref": "#/$defs/sha"},
        "stage_execution_receipt_ref": {"type": "string", "pattern": "^study-intake-(model-stage-execution|direct-model-stage-execution)://sha256/[0-9a-f]{64}$"},
        "normalization_receipt_sha256": {"$ref": "#/$defs/sha"},
        "normalization_receipt_ref": {"type": "string", "pattern": "^study-intake-(model-stage-normalization|direct-model-stage-normalization)://sha256/[0-9a-f]{64}$"},
        "formal_write_count": {"const": 0}
      }
    },
    "luna_binding": {"type": "object", "required": ["branch_id", "kind", "schema_version", "sha256", "ref", "report_sha256", "branch_result_sha256", "branch_result_ref"], "properties": {"branch_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["investigation_report", "diagnostic_record"]}, "schema_version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "ref": {"type": "string", "pattern": "^study-intake-luna-(investigation-report|diagnostic-record)://sha256/[0-9a-f]{64}$"}, "report_sha256": {"$ref": "#/$defs/sha"}, "branch_result_sha256":{"$ref":"#/$defs/sha"},"branch_result_ref":{"type":"string","minLength":1},"execution_artifacts":{"type":"object"}}}
  }
}
