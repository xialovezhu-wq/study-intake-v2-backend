{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/sol-handoff-envelope-v2.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "subject", "capture_id", "plan_sha256", "read_bundle_sha256", "candidate_sha256", "review_sha256", "risk_report_sha256", "sol_review_ready", "diagnostic_review_ready", "quality_clean", "allowed_sol_actions", "formal_apply_authorized", "ordered_luna_reports", "terra_final_report", "formal_write_count", "handoff_sha256"],
  "properties": {
    "schema_version": {"const": "sol_handoff_envelope_v2"}, "subject": {"enum": ["math", "cs408", "english"]}, "capture_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"$ref": "#/$defs/sha"}, "read_bundle_sha256": {"$ref": "#/$defs/sha"}, "candidate_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "review_sha256": {"$ref": "#/$defs/sha"}, "risk_report_sha256": {"$ref": "#/$defs/sha"},
    "sol_review_ready": {"type": "boolean"}, "diagnostic_review_ready": {"type": "boolean"}, "quality_clean": {"type": "boolean"},
    "allowed_sol_actions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["adopt", "modify", "reject", "request_more_evidence"]}},
    "formal_apply_authorized": {"const": false},
    "ordered_luna_reports": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/luna_binding"}},
    "terra_final_report": {"type": "object", "additionalProperties": false, "required": ["report_sha256", "report_ref"], "properties": {"report_sha256": {"$ref": "#/$defs/sha"}, "report_ref": {"type": "string", "pattern": "^study-intake-terra-final-report://sha256/[0-9a-f]{64}$"}}},
    "formal_write_count": {"const": 0}, "handoff_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "luna_binding": {"type": "object", "additionalProperties": false, "required": ["branch_id", "report_sha256", "report_ref"], "properties": {"branch_id": {"type": "string", "minLength": 1}, "report_sha256": {"$ref": "#/$defs/sha"}, "report_ref": {"type": "string", "pattern": "^study-intake-luna-investigation-report://sha256/[0-9a-f]{64}$"}}}
  }
}
