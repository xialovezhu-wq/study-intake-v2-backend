{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/luna-investigation-draft-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "subject", "capture_id", "branch_id", "summary", "findings", "conflicts", "missing_evidence", "confidence", "evidence_refs", "formal_write_count"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["luna_investigation_draft_v1"]}, "subject": {"type": "string", "enum": ["math", "cs408", "english"]}, "capture_id": {"type": "string", "minLength": 1}, "branch_id": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1, "maxLength": 16000},
    "findings": {"$ref": "#/$defs/strings"}, "conflicts": {"$ref": "#/$defs/strings"}, "missing_evidence": {"$ref": "#/$defs/strings"}, "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "formal_write_count": {"type": "integer", "enum": [0]}
  },
  "$defs": {"strings": {"type": "array", "items": {"type": "string", "minLength": 1}}}
}
