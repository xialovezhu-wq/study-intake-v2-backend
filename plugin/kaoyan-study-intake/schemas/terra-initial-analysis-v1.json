{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/terra-initial-analysis-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "subject", "capture_id", "frozen_capture_sha256", "summary", "analysis", "proposed_branches", "evidence_refs", "formal_write_count", "report_sha256"],
  "properties": {
    "schema_version": {"const": "terra_initial_analysis_v1"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "capture_id": {"type": "string", "minLength": 1},
    "frozen_capture_sha256": {"$ref": "#/$defs/sha"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 16000},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["sections"], "properties": {"sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}}},
    "proposed_branches": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/branch"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "formal_write_count": {"const": 0}, "report_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "section": {"type": "object", "additionalProperties": false, "required": ["kind", "summary", "evidence_refs"], "properties": {"kind": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}, "branch": {"type": "object", "additionalProperties": false, "required": ["branch_id", "purpose", "rationale"], "properties": {"branch_id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}}}
}
