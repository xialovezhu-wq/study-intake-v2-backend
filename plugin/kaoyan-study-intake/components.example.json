{
  "schema_version": "kaoyan-study-intake-components.v1",
  "agent_plugins_spec": "1.0.0",
  "plugin": {
    "name": "kaoyan-study-intake",
    "version": "0.6.0+codex.20260818-prelive-finalization",
    "description": "Offline-locked Study Intake commissioning with three-subject foreground closure, capture-free Sol MCP preflight, protected validation console, and proposal-only Terra/Luna production contracts.",
    "author": {
      "name": "Xiazhibin Local Study Systems"
    },
    "keywords": [
      "kaoyan",
      "study-intake",
      "mcp",
      "luna",
      "skills"
    ]
  },
  "external_runtime_sources": {
    "math_status_script": {
      "path": "${MATH_ROOT}/数学一回滚复习系统/scripts/quick_intake.py",
      "sha256": "${MATH_STATUS_SCRIPT_SHA256}"
    },
    "cs408_status_script": {
      "path": "${CS408_ROOT}/scripts/intake_fact_capture_408.py",
      "sha256": "${CS408_STATUS_SCRIPT_SHA256}"
    },
    "english_events_module": {
      "path": "${ENGLISH_ROOT}/english_pipeline/events.py",
      "sha256": "${ENGLISH_EVENTS_MODULE_SHA256}"
    }
  },
  "foreground_capture_contracts": {
    "math": {
      "descriptor_path": "${MATH_ROOT}/数学一回滚复习系统/schema/producer-binding-v1.json",
      "descriptor_sha256": "${MATH_DESCRIPTOR_SHA256}",
      "attestation_required_after": "${MATH_ATTESTATION_REQUIRED_AFTER}",
      "producer_source_closure_sha256": "${MATH_PRODUCER_SOURCE_CLOSURE_SHA256}",
      "foreground_skill_sha256": "${MATH_FOREGROUND_SKILL_SHA256}"
    },
    "cs408": {
      "descriptor_path": "${CS408_ROOT}/schema/producer-binding-v1.json",
      "descriptor_sha256": "${CS408_DESCRIPTOR_SHA256}",
      "attestation_required_after": "${CS408_ATTESTATION_REQUIRED_AFTER}",
      "producer_source_closure_sha256": "${CS408_PRODUCER_SOURCE_CLOSURE_SHA256}",
      "foreground_skill_sha256": "${CS408_FOREGROUND_SKILL_SHA256}"
    },
    "english": {
      "descriptor_path": "${ENGLISH_ROOT}/schema/english_pipeline/producer-binding-v1.json",
      "descriptor_sha256": "${ENGLISH_DESCRIPTOR_SHA256}",
      "attestation_required_after": "${ENGLISH_ATTESTATION_REQUIRED_AFTER}",
      "producer_source_closure_sha256": "${ENGLISH_PRODUCER_SOURCE_CLOSURE_SHA256}",
      "foreground_skill_sha256": "${ENGLISH_FOREGROUND_SKILL_SHA256}"
    }
  },
  "fixture_contracts": {
    "math": {
      "profile": "multi_agent_v2_math_v2",
      "path": "tests/fixtures/multi_agent_v2/math-contract-vector-v2.json",
      "sha256": "911a23673f146798fb4d8edbf8090a49a01a5a4b73ee9fdd71e411515b2b818f"
    },
    "cs408": {
      "profile": "multi_agent_v2_cs408_v2",
      "path": "tests/fixtures/multi_agent_v2/cs408-contract-vector-v2.json",
      "sha256": "9d67bd1716625aa2adcd2ae643a2152ff646c8efa8408dfc2d34606bbd56a81e"
    },
    "english": {
      "profile": "multi_agent_v2_english_v2",
      "path": "tests/fixtures/multi_agent_v2/english-contract-vector-v2.json",
      "sha256": "ec0a6ff8a961b09aefa57e2ce3e97a1287b6de4bd3c3efc9bdc05d2552a9ec1d"
    }
  },
  "sol_mcp_preflight": {
    "purpose": "infrastructure_preflight",
    "launcher_mode": "preflight-server",
    "tool_policy": "agents/sol-mcp-preflight-tool-policy.json",
    "enabled_tools": [
      "list_records",
      "get_records",
      "search_records",
      "query_relations"
    ],
    "session_schema": "study-read-mcp-infrastructure-preflight-session.v1",
    "call_receipt_schema": "sol-mcp-preflight-call-receipt-v1",
    "terminal_schema": "sol-mcp-preflight-terminal-v1",
    "write_call_count": 0,
    "formal_write_count": 0
  },
  "mcp": {
    "minimum_server_release": "0.4.1",
    "server_release": "${MCP_SERVER_RELEASE}",
    "release_root": "${MCP_ROOT}",
    "release_id": "${MCP_RELEASE_ID}",
    "release_manifest": "${MCP_ROOT}/release.json",
    "release_manifest_sha256": "${MCP_RELEASE_MANIFEST_SHA256}",
    "python_executable": "${MCP_PYTHON_EXECUTABLE}",
    "python_flags": [
      "-I",
      "-S"
    ],
    "sealed_launcher_path": "${MCP_ROOT}/scripts/sealed_launcher.py",
    "sealed_launcher_sha256": "${MCP_SEALED_LAUNCHER_SHA256}",
    "launcher": "./bin/kaoyan-read",
    "profile": "ordinary",
    "legacy_server_names": [
      "kaoyan_read",
      "kaoyan_read_v2",
      "kaoyan_read_v3"
    ],
    "focused_tool_names": [
      "get_task_context",
      "read_task_artifact",
      "list_records",
      "get_records",
      "search_records",
      "query_relations"
    ],
    "ordinary_servers": {
      "math": {
        "server_name": "kaoyan_math_read",
        "subject": "math",
        "tool_name": "math_read_bundle"
      },
      "cs408": {
        "server_name": "kaoyan_cs408_read",
        "subject": "cs408",
        "tool_name": "cs408_read_bundle"
      },
      "english": {
        "server_name": "kaoyan_english_read",
        "subject": "english",
        "tool_name": "english_read_bundle"
      }
    },
    "luna_servers": {
      "math": {
        "server_name": "kaoyan_math_read",
        "launch_mode": "subject-server"
      },
      "cs408": {
        "server_name": "kaoyan_cs408_read",
        "launch_mode": "subject-server"
      },
      "english": {
        "server_name": "kaoyan_english_read",
        "launch_mode": "subject-server"
      }
    },
    "ordinary_skill_tools": {
      "kaoyan-math-visual-review": {
        "subject": "math",
        "tool_name": "math_read_bundle"
      },
      "kaoyan-math-weak-edge-audit": {
        "subject": "math",
        "tool_name": "math_read_bundle"
      },
      "kaoyan-math-nightly-qa": {
        "subject": "math",
        "tool_name": "math_read_bundle"
      },
      "kaoyan-english-vocab-export": {
        "subject": "english",
        "tool_name": "english_read_bundle"
      },
      "kaoyan-english-intensive-reading": {
        "subject": "english",
        "tool_name": "english_read_bundle"
      },
      "kaoyan-english-daily-intake-curation": {
        "subject": "english",
        "tool_name": "english_read_bundle"
      },
      "kaoyan-408-daily-intake-curation": {
        "subject": "cs408",
        "tool_name": "cs408_read_bundle"
      }
    }
  },
  "multi_agent": {
    "schema_version": "study-intake-multi-agent-component-registry-v1",
    "orchestrate_skill": {
      "id": "multi-agent-read-orchestrate",
      "version": "1.1.0",
      "path": "skills/multi-agent-read-orchestrate/SKILL.md"
    },
    "roles": {
      "orchestrator": {
        "model": "gpt-5.6-terra",
        "reasoning_effort": "ultra",
        "agents_enabled": true,
        "agent_config": "agents/terra-orchestrator.toml",
        "tool_policy": "agents/terra-orchestrator-tool-policy.json"
      },
      "reader": {
        "model": "gpt-5.6-luna",
        "reasoning_effort": "max",
        "agents_enabled": false,
        "agent_config": "agents/luna-reader.toml",
        "tool_policy": "agents/luna-reader-tool-policy.json"
      },
      "critical_reviewer": {
        "model": "gpt-5.6-terra",
        "reasoning_effort": "ultra",
        "agents_enabled": false,
        "fresh_context": true,
        "agent_config": "agents/terra-critical-reviewer.toml",
        "tool_policy": "agents/terra-critical-reviewer-tool-policy.json"
      },
      "terra_analysis": {
        "model": "gpt-5.6-terra",
        "reasoning_effort": "max",
        "agents_enabled": false,
        "fresh_context": true,
        "sandbox_mode": "read-only",
        "agent_config": "agents/terra-analysis.toml",
        "tool_policy": "agents/terra-analysis-tool-policy.json"
      },
      "luna_analysis": {
        "model": "gpt-5.6-luna",
        "reasoning_effort": "max",
        "agents_enabled": false,
        "fresh_context": true,
        "sandbox_mode": "read-only",
        "agent_config": "agents/luna-analysis.toml",
        "tool_policy": "agents/luna-analysis-tool-policy.json"
      },
      "terra_critical_review": {
        "model": "gpt-5.6-terra",
        "reasoning_effort": "max",
        "agents_enabled": false,
        "fresh_context": true,
        "sandbox_mode": "read-only",
        "agent_config": "agents/terra-critical-review.toml",
        "tool_policy": "agents/terra-critical-review-tool-policy.json"
      }
    },
    "consumer_stage_chain": {
      "enabled": true,
      "stages": [
        {
          "stage": "terra_analysis",
          "role": "terra_analysis"
        },
        {
          "stage": "luna_analysis",
          "role": "luna_analysis"
        },
        {
          "stage": "terra_critical_review",
          "role": "terra_critical_review"
        }
      ],
      "formal_write_count": 0
    },
    "logical_branch_limit": null,
    "physical_concurrency_mode": "dynamic",
    "overflow_policy": "queue_in_waves",
    "drop_policy": "never",
    "formal_write_count": 0
  },
  "skills": {
    "multi-agent-read-orchestrate": "1.1.0",
    "background-math-processing": "4.0.1",
    "background-cs408-processing": "4.0.1",
    "background-english-processing": "4.0.1",
    "kaoyan-math-visual-review": "2.1.0",
    "kaoyan-math-weak-edge-audit": "2.1.0",
    "kaoyan-math-nightly-qa": "2.1.0",
    "kaoyan-english-vocab-export": "2.1.0",
    "kaoyan-english-intensive-reading": "2.1.1",
    "kaoyan-english-daily-intake-curation": "2.1.0",
    "kaoyan-408-daily-intake-curation": "2.1.0"
  }
}
